# Database
DATABASE_URL=postgresql://user:password@localhost:5432/top_vino

# The candidate entrypoint uses a separate direct owner URL for migrations,
# then removes it before execing the API. Never set it in frontend or CI.
# DIRECT_URL=postgresql://migration-owner:private-password@direct-host:5432/top_vino
# Missing runtime pool options default to connection_limit=5, connect_timeout=15,
# pool_timeout=10. Production DATABASE_URL uses a separate least-privilege role.

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
# Production requires versioned keys instead of the singular development key.
# First entry is the current highest version; retain prior keys for eight days.
# Set real values only in the runtime dashboard; see docs/synthetic-testers.md.
# BETTER_AUTH_SECRETS=2:<new-random-key>,1:<previous-random-key>
BETTER_AUTH_URL=http://localhost:8000

# App
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000
# Omit or use false locally. Only render-1 is accepted as a deployment opt-in,
# after verifying the single trusted edge hop; see docs/browser-boundary.md.
TRUST_PROXY=false

# Development data tools (local only)
# Opt-in flag for the docs/dev data commands (npm run docs:seed and
# npm run docs:reset / db:reset:dev, which empties the local database).
# Disabled by default; never required for server startup. Set to "true"
# only alongside NODE_ENV=development and a local DATABASE_URL host.
DOCS_DATA_TOOLS_ENABLED=false

# Workstation-only sandbox tester command (never set these on the API service).
# SANDBOX_TESTER_TOOLS_ENABLED=true
# SANDBOX_DATABASE_TARGET=<verified-host:port/database>
# SANDBOX_PROVISIONING_DATABASE_URL=<temporary-postgresql-credential>

# Workstation-only fixture seed/reset/status. Never set on the API service.
# SANDBOX_DATA_TOOLS_ENABLED=true
# SANDBOX_DATABASE_TARGET=<independently-verified-host:port/database>

# Logging
# Optional explicit override for the level derived from NODE_ENV.
# Must be one of: trace, debug, info, warn, error, fatal, silent.
# An invalid value fails startup. See docs/logging.md.
# LOG_LEVEL=
