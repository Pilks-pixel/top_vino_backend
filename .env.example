# Database
DATABASE_URL=postgresql://user:password@localhost:5432/top_vino

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:8000

# App
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000

# Development data tools (local only)
# Opt-in flag for destructive docs/dev data commands (npm run docs:reset).
# Disabled by default; never required for server startup. Set to "true"
# only alongside NODE_ENV=development and a local DATABASE_URL host.
DOCS_DATA_TOOLS_ENABLED=false

# Logging
# Optional explicit override for the level derived from NODE_ENV.
# Must be one of: trace, debug, info, warn, error, fatal, silent.
# An invalid value fails startup. See docs/logging.md.
# LOG_LEVEL=
