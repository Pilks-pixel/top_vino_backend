# Database
DATABASE_URL=postgresql://user:password@localhost:5432/top_vino

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:8000

# App
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000

# Logging
# Optional explicit override for the level derived from NODE_ENV.
# Must be one of: trace, debug, info, warn, error, fatal, silent.
# An invalid value fails startup. See docs/logging.md.
# LOG_LEVEL=
