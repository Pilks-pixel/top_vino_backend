{
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "strict": true,
    "noImplicitAny": true,
    "declaration": false,
    "skipLibCheck": true,
    "types": ["node", "jest"]
    // "outDir": "dist",
  },
  "exclude": ["dist"],
  "include": ["src/**/*", "__tests__/**/*"]
}
